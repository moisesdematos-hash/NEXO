# NEXO — Configuração de Ambiente para Produção (.env.example)

# 1. Supabase Configuration (Obrigatório)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. App Identidade & Marca
VITE_APP_NAME=NEXO
VITE_APP_SLOGAN="Tudo o que precisas. Num só lugar."

# 3. Groq AI Configuration (Restrito ao Ambiente de Servidor / Supabase Edge Function ONLY)
# AVISO DE SEGURANÇA: NUNCA expor GROQ_API_KEY no cliente React (não usar o prefixo VITE_)
GROQ_API_KEY=gsk_your_groq_api_key_here
